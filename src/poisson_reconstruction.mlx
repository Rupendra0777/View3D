<!DOCTYPE FilterScript>
<FilterScript>
  <filter name="Compute normals for point sets">
    <Param type="RichInt" value="20" name="K"/>
    <Param type="RichInt" value="0" name="smoothIter"/>
    <Param type="RichBool" value="true" name="flipFlag"/>
    <Param type="RichPoint3f" x="0" y="0" z="0" name="viewPos"/>
  </filter>
  <filter name="Surface Reconstruction: Screened Poisson">
    <Param type="RichBool" value="false" name="visibleLayer"/>
    <Param type="RichInt" value="6" name="depth"/>
    <Param type="RichInt" value="4" name="fullDepth"/>
    <Param type="RichInt" value="0" name="cgDepth"/>
    <Param type="RichFloat" value="1.1" name="scale"/>
    <Param type="RichFloat" value="5" name="samplesPerNode"/>
    <Param type="RichFloat" value="4" name="pointWeight"/>
    <Param type="RichInt" value="8" name="iters"/>
    <Param type="RichBool" value="false" name="confidence"/>
    <Param type="RichBool" value="true" name="preClean"/>
  </filter>
</FilterScript>
